# GEMINI_API_KEY: Required for Google Gemini AI code analysis, patch generation, and Ask AutoPatch chat.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model used by AutoPatch AI (default: gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"

# JWT_SECRET: Secret key used to sign authentication tokens (auto-generated fallback used in local dev if unset)
JWT_SECRET="replace-with-strong-random-secret"

# DATABASE_PATH: Path to SQLite database file (default: ./data/autopatch.db)
DATABASE_PATH="./data/autopatch.db"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# CORS_ORIGIN: Allowed origins for CORS (comma-separated, or * for local development)
CORS_ORIGIN="*"
